<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <!-- NuGet package ids use the ScipSharp prefix (the `Scip` id is taken): Scip -> ScipSharp, Scip.Indexing -> ScipSharp.Indexing,
         Scip.Indexer.Java -> ScipSharp.Indexer.Java, Scip.Cli -> ScipSharp.Cli. Assembly names and namespaces stay `Scip.*`. -->
    <PackageId>$(MSBuildProjectName.Replace('Scip', 'ScipSharp'))</PackageId>
    <Authors>SCIP Maintainers</Authors>
    <Company>Curiosity GmbH</Company>
    <Copyright>Copyright (c) SCIP Maintainers (Apache-2.0); .NET port by Curiosity GmbH</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/theolivenbaum/scip</PackageProjectUrl>
    <RepositoryUrl>https://github.com/theolivenbaum/scip</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>scip;code-intelligence;indexer;lsif;code-navigation</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Overridden by the build pipeline: dotnet pack /p:Version=yyyy.M.buildId -->
    <Version>0.10.0</Version>
  </PropertyGroup>
</Project>
