 SUMMARY: PROC (T) RETURNS (FIXED DEC(9,2));
   DCL T FIXED BIN(31);
   DCL LOG_LEVEL FIXED BIN(15) EXTERNAL;
   DCL LOGGER ENTRY (CHAR(*), BIT(1));
   IF LOG_LEVEL > 0 THEN CALL LOGGER('SUMMARY', '1'B);
   RETURN (T / 100);
 ALT_SUMMARY: ENTRY (T) RETURNS (FIXED DEC(9,2));
   RETURN (T);
 END SUMMARY;
