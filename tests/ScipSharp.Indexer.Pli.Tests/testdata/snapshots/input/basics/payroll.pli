*PROCESS MARGINS(2,72) SOURCE;
 /* Payroll sample: structures, factored declarations, scoping.     */
 PAYROLL: PROCEDURE OPTIONS(MAIN);
   DCL (COUNT, TOTAL) FIXED BINARY(31) INIT(0);
   DCL 1 EMPLOYEE,
         2 NAME        CHAR(20),
         2 PAY,
           3 RATE      FIXED DEC(7,2),
           3 HOURS     FIXED DEC(5,1),
         2 DEPT        CHAR(4);
   DCL 1 MANAGER LIKE EMPLOYEE;
   DCL SUMMARY ENTRY (FIXED BIN(31)) RETURNS (FIXED DEC(9,2));
   DCL (SUBSTR, LENGTH) BUILTIN;
   DCL EOF BIT(1) INIT('0'B);
   %INCLUDE COMMON;

   ON ENDFILE(SYSIN) EOF = '1'B;
   GET LIST (EMPLOYEE.NAME, RATE, PAY.HOURS);
   DO WHILE (¬EOF);
     COUNT = COUNT + 1;
     TOTAL = TOTAL + EMPLOYEE.PAY.RATE * HOURS;
     MANAGER.NAME = SUBSTR(NAME, 1, LENGTH(NAME));
     IF MANAGER.PAY.RATE > LIMIT THEN CALL REPORT(COUNT);
     ELSE GO TO NEXT;
 NEXT:
     GET LIST (EMPLOYEE.NAME, RATE, PAY.HOURS);
   END;
   PUT SKIP EDIT ('TOTAL:', SUMMARY(TOTAL)) (A, F(9,2));
   CALL LOGGER('DONE', UNDECLARED_FLAG);

 REPORT: PROCEDURE (N);
   DCL N FIXED BINARY(31);
   DCL TEMP CHAR(20);
   TEMP = NAME;
   PUT SKIP LIST (N, TEMP, DEPT);
 END REPORT;

 BLOCK1: BEGIN;
   DCL COUNT FIXED DEC(3);
   COUNT = 0;
   OUTER: DO I = 1 TO 10 BY 2;
     IF I > 5 THEN LEAVE OUTER;
     COUNT = COUNT + I;
   END OUTER;
 END BLOCK1;
 END PAYROLL;                                                           00470000
