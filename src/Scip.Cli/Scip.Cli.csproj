<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Scip.Cli</RootNamespace>
    <AssemblyName>Scip.Cli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>scip</ToolCommandName>
    <Description>The scip command-line tool (print, lint, stats, snapshot, test, expt-convert, index) with built-in pure-.NET indexers for C#/VB, Java, TypeScript/JavaScript, Python, Ruby, Rust, C/C++, Dart and PHP.</Description>
    <PackageTags>$(PackageTags);dotnet-tool</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="ZstdSharp.Port" />
    <EmbeddedResource Include="version.txt" LogicalName="version.txt" />
    <ProjectReference Include="..\Scip\Scip.csproj" />
    <ProjectReference Include="..\Scip.Indexing\Scip.Indexing.csproj" />
    <ProjectReference Include="..\Indexers\Scip.Indexer.Clang\Scip.Indexer.Clang.csproj" />
    <ProjectReference Include="..\Indexers\Scip.Indexer.Dart\Scip.Indexer.Dart.csproj" />
    <ProjectReference Include="..\Indexers\Scip.Indexer.DotNet\Scip.Indexer.DotNet.csproj" />
    <ProjectReference Include="..\Indexers\Scip.Indexer.Java\Scip.Indexer.Java.csproj" />
    <ProjectReference Include="..\Indexers\Scip.Indexer.Php\Scip.Indexer.Php.csproj" />
    <ProjectReference Include="..\Indexers\Scip.Indexer.Python\Scip.Indexer.Python.csproj" />
    <ProjectReference Include="..\Indexers\Scip.Indexer.Ruby\Scip.Indexer.Ruby.csproj" />
    <ProjectReference Include="..\Indexers\Scip.Indexer.Rust\Scip.Indexer.Rust.csproj" />
    <ProjectReference Include="..\Indexers\Scip.Indexer.TypeScript\Scip.Indexer.TypeScript.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Scip.Cli.Tests" />
  </ItemGroup>
</Project>
