<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Scip</RootNamespace>
    <AssemblyName>Scip</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Scip</PackageId>
    <Description>.NET library for the SCIP Code Intelligence Protocol: protobuf types, symbol parsing/formatting, positions and ranges.</Description>
    <!-- Generated protobuf code is not documented / style-clean. -->
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <Protobuf Include="Protos\scip.proto" GrpcServices="None" />
  </ItemGroup>
</Project>
