<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ScipSharp.Indexer.Delphi</RootNamespace>
    <!-- CA1822/CA1859 are style-only here: helpers stay instance members of the walker/model for readability. -->
    <NoWarn>$(NoWarn);CA1822;CA1859</NoWarn>
    <Description>Native C# SCIP indexer for Delphi / Object Pascal.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ScipSharp.Indexer.Delphi.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Stubs\*.pas" LogicalName="Stubs.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ScipSharp.Indexing\ScipSharp.Indexing.csproj" />
  </ItemGroup>
</Project>
